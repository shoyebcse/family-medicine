# Sign-in needs the backend. Sample data is an explicit choice on the sign-in screen.
# Never put a production credential in EXPO_PUBLIC variables.
# Android emulator uses http://10.0.2.2:8080; web uses http://localhost:8080.
# EXPO_PUBLIC_API_URL=http://localhost:8080
# Physical Android device: use your computer's trusted LAN IP instead of localhost.
# Never put a password, bearer token or SMS provider secret here.

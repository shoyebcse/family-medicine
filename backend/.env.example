# Set in the shell running Maven; Spring does not automatically load .env files.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/family_medicine
DATABASE_USER=family_medicine
DATABASE_PASSWORD=<choose-a-local-database-password>
DEV_API_TOKEN=<generate-a-local-token-at-least-24-characters>
# localhost by default. Only change for a controlled physical-device test.
SERVER_ADDRESS=127.0.0.1

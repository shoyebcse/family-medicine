# Local development settings only. Copy to .env and generate your own random values.
DATABASE_PASSWORD=replace-with-a-random-local-database-password
DEV_API_TOKEN=replace-with-a-random-local-token-at-least-24-characters
# Alternate port avoids Windows reservations affecting the usual PostgreSQL port.
DATABASE_PORT=15432

# Google Auth Platform web client. Keep the client secret on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/callback
GOOGLE_WEB_RETURN_URL=http://localhost:8081/

# Twilio Verify. Enabling this can send billable verification SMS.
SMS_SIGN_IN_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Prescription extraction is disabled until explicitly configured on the backend.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
PRESCRIPTION_EXTRACTION_ENABLED=false
# mock is available only in the dev profile and bypasses OpenAI completely.
PRESCRIPTION_EXTRACTION_MODE=mock
# Sensitive response bodies: development profile only. Disable after debugging.
OPENAI_LOG_RESPONSES=false
# Base64 of 32 random bytes; required outside dev/test. Keep stable and backed up.
PRESCRIPTION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

